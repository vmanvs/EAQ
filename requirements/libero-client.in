# LIBERO evaluation client (Python 3.8): openpi's examples/libero/main.py, run unmodified.
# Compiled into libero-client.txt with openpi's own lock as constraints:
#   uv pip compile requirements/libero-client.in -o requirements/libero-client.txt \
#     --python-version 3.8 --python-platform x86_64-manylinux_2_28 \
#     --constraints <openpi examples/libero/requirements.txt> --excludes requirements/libero-client.exclude \
#     --extra-index-url https://download.pytorch.org/whl/cpu --index-strategy unsafe-best-match
# openpi 215abfb217dbac7d5f1273282331b9b1866c0479, LIBERO f78abd68ee283de9f9be3c8f7e2a9ad60246e95c.

# openpi examples/libero/requirements.in
imageio[ffmpeg]
numpy
tqdm
tyro
PyYaml
robosuite
matplotlib
# Headless build of openpi's opencv-python 4.6.0.66: the full build needs libGL.
opencv-python-headless==4.6.0.66
# openpi pins torch 1.11.0 (cu113); LIBERO only calls torch.load on its init states. 1.11's
# libtorch_cpu.so requests an executable stack, which glibc 2.41+ (Molab) refuses to load, so this
# is the CPU build of 2.4.1, the last release for Python 3.8.
torch==2.4.1+cpu

# LIBERO's runtime imports under libero/libero (its requirements.txt also lists training-only
# packages: hydra, wandb, transformers, robomimic, einops, thop).
bddl==1.0.1
easydict==1.9
cloudpickle==2.1.0
gym==0.25.2
future==0.18.2
termcolor

# openpi-client from the source archive at the same openpi commit (a git install clones submodules).
openpi-client @ https://github.com/Physical-Intelligence/openpi/archive/215abfb217dbac7d5f1273282331b9b1866c0479.tar.gz#subdirectory=packages/openpi-client
